#Change every information with bracets (example: "[password]" -> "12345")

MONGODB_USERNAME="[USERNAME]"
MONGODB_PASSWORD="[PASSWORD]"
MONGODB_HOST= "[DOMAIN/IP]"
MONGODB_DATABASE= "[DB_NAME]" # dev or prod
MONGODB_URI="mongodb+srv://[USERNAME]:[PASSWORD]@[DOMAIN/IP]/[DB_NAME]"

JWT_SECRET="[node -p "crypto.randomBytes(32).toString('base64')"]"

CLOUDINARY_CLOUD_NAME="[CLOUD_NAME]"
CLOUDINARY_API_KEY="[API_KEY]"
CLOUDINARY_API_SECRET="[API_SECRET]"
CLOUDINARY_URL="cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]"