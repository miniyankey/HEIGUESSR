{
  "name": "express-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch bin/start.js",
    "start": "node bin/start.js",
    "test": "node --import ./test/setup-env.js --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\"",
    "set-role": "node --env-file-if-exists=.env scripts/set-role.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.9 || ^24 || ^26"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
